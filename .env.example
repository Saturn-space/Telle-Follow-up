# Copy this file to .env and replace placeholders with local credentials.
# Local demo Compose database only. Keep existing .env values unless you intend to switch databases.
DATABASE_URL="postgresql://teleflow_demo:LocalDemoDb2026!@localhost:5433/tele_follow_up_demo?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
DOCUMENT_STORAGE_KEY="base64-encoded-32-byte-key"
DOCUMENT_STORAGE_PATH=".private-data/documents"

# Next.js web server
PORT=8000
APP_URL="http://localhost:8000"
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Risk explanation is optional; rule based scoring remains available without it.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Optional travel routing/geocoding service configuration.
GEOCODING_SERVICE_URL=""
OCR_SERVICE_URL=""
OCR_API_KEY=""

# Payments are disabled unless account-specific Razorpay TEST credentials are configured and enabled.
# Do not use live credentials for local testing.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# The public Jitsi domain does not need app credentials. Self-hosted domains may use their own auth.
JITSI_DOMAIN="meet.jit.si"
