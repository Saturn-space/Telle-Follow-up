{
  "name": "tele-follow-up-orchestrator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 8000",
    "build": "next build",
    "start": "next start",
    "server": "next dev --port 8000",
    "setup:env": "node scripts/setup-env.js",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:demo:start": "docker compose -f docker-compose.demo.yml up -d",
    "db:demo:stop": "docker compose -f docker-compose.demo.yml stop",
    "seed:admin": "tsx scripts/seed-database.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "lint": "eslint app components context hooks lib tests scripts/seed-database.ts scripts/seed-demo.ts scripts/setup-env.js",
    "clean": "next clean",
    "test:unit": "npx tsx scripts/test-provider-directory.ts && npx tsx scripts/test-phase3-hardening.ts",
    "test:api": "npx tsx scripts/test-api-endpoints.ts && npx tsx scripts/test-api-security.ts",
    "test:maintenance": "npx tsx scripts/test-phase5-maintenance.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@next/env": "^15.5.28",
    "@prisma/client": "5.22.0",
    "@types/leaflet": "^1.9.22",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "prisma": "5.22.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
